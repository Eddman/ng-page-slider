{
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "./projects/out-tsc",
        "module": "es2022",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "experimentalDecorators": true,
        "types": [],
        "lib": [
            "ES2023",
            "dom"
        ],
        "sourceMap": true,
        "declaration": false,
        "skipLibCheck": true,
        "allowJs": false,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "alwaysStrict": true,
        "pretty": true,
        "strict": true
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "typeCheckHostBindings": true,
        "strictTemplates": true
    },
    "exclude": [
        "dist/",
        "**/out-tsc/"
    ]
}
