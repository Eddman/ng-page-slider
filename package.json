{
    "name": "@netocny/ng-page-slider",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Eddman/ng-page-slider"
    },
    "scripts": {
        "ng": "ng",
        "build": "ng build @netocny/ng-page-slider --configuration production && npm run themes && npm run static",
        "lint": "ng lint",
        "themes": "bundle-scss --config",
        "static": "cp LICENSE README.md .npmignore dist/netocny/ng-page-slider/ && cp .npmrc_publish dist/netocny/ng-page-slider/.npmrc"
    },
    "bundleStyle": {
        "dest": "./dist/netocny/ng-page-slider/ng-page-slider.scss",
        "mask": "./projects/netocny/ng-page-slider/src/styles.scss",
        "sort": [
            "component"
        ]
    },
    "dependencies": {
        "@angular/common": "^22.2.0",
        "@angular/compiler": "^22.2.0",
        "@angular/core": "^22.2.0",
        "rxjs": "^7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "^22.2.0",
        "@angular/cli": "^22.2.0",
        "@angular/compiler-cli": "^22.2.0",
        "@eslint/js": "^9.18.0",
        "@types/node": "^24.0.0",
        "angular-eslint": "^22.5.0",
        "bundle-scss": "^1.5.1",
        "eslint": "^9.18.0",
        "ng-packagr": "^22.2.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1"
    }
}
